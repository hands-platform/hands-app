# Short-lived server-to-server Admin Web API tokens. Keep separate from all JWT,
# realtime, and session-cookie secrets.
ADMIN_WEB_API_TOKEN_SECRET=
ADMIN_WEB_LOGIN_EMAIL=
ADMIN_WEB_LOGIN_PASSWORD_HASH=
ADMIN_WEB_LOGIN_PASSWORD_SALT=
# One-time explicit MASTER_ADMIN user id for `npm run admin:bootstrap-operator`.
# Required in production; local development may resolve the legacy Admin token subject.
ADMIN_OPERATOR_BOOTSTRAP_USER_ID=
ADMIN_WEB_LOGIN_PASSWORD=
# Dev login fallback must stay false for shared/staging/production templates.
# Local developers may set true only in their uncommitted .env.
ADMIN_WEB_ALLOW_DEV_LOGIN=false
ADMIN_WEB_SESSION_COOKIE_SECRET=
ADMIN_WEB_SESSION_TTL_SECONDS=28800
# Dev realtime-token fallback must stay false for shared/staging/production templates.
