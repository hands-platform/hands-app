# HANDS staging environment template.
# Copy the values you receive from external consoles into your local .env.
# Keep real secrets outside Git.

NODE_ENV=development
API_PORT=3000

# HANDS identity and operator ownership.
APP_DOMAIN=hands.vn
PUBLIC_WEB_URL=https://hands.vn
API_PUBLIC_URL=https://api.hands.vn
ADMIN_PUBLIC_URL=https://admin.hands.vn
ADMIN_EMAIL=administration@hands.vn
SUPPORT_EMAIL=administration@hands.vn

# Local services stay local until a hosted database is chosen.
DATABASE_URL=postgresql://massage:massage@localhost:5432/massage_vn?schema=public
REDIS_URL=redis://localhost:6379

# Local JWT secrets for Nest-issued tokens.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Auth migration mode.
# Keep nest until Supabase Phone Auth and auth:supabase-smoke pass.
AUTH_BACKEND=nest

# Supabase project values from Project Settings > API.
SUPABASE_URL=https://adzpstrkpzwpukuboxzj.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# OTP.
SMS_PROVIDER=dev
DEV_OTP=123456
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=HANDS

# Low-cost map and address search.
MAPTILER_API_KEY=
GEOAPIFY_API_KEY=
PROVIDER_SEARCH_RADIUS_METERS=5000
PROVIDER_STALE_AFTER_MINUTES=30
PROVIDER_HIDE_AFTER_HOURS=24
ANDROID_CUSTOMER_UPLOAD_KEYSTORE=
ANDROID_PROVIDER_UPLOAD_KEYSTORE=

# Storage. Local MinIO works for MVP; replace with Supabase Storage S3, R2, or S3-compatible storage for staging.
STORAGE_PROVIDER=s3-compatible
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=massage-vn
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/massage-vn

# Vietnam payments.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Admin web.
ADMIN_API_BASE_URL=http://localhost:3100/api
ADMIN_ACCESS_TOKEN=
ADMIN_DEMO_PHONE=+84900000099
ADMIN_DEMO_OTP=123456

# Future OS push provider. Firebase Messaging is intentionally removed.
PUSH_PROVIDER=in_app_only
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
