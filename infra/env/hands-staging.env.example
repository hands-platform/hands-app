# HANDS staging environment template.
# Copy the values you receive from external consoles into your local .env.
# Keep real secrets outside Git.

NODE_ENV=development
API_PORT=3000

# HANDS identity and operator ownership.
APP_DOMAIN=hands.vn
PUBLIC_WEB_URL=https://hands.vn
API_PUBLIC_URL=https://api.hands.vn
ADMIN_PUBLIC_URL=https://admin.hands.vn
HANDS_NGINX_BIND_ADDRESS=127.0.0.1
HANDS_NGINX_HTTP_PORT=80
CORS_ORIGINS=http://localhost:3101
ADMIN_EMAIL=administration@hands.vn
SUPPORT_EMAIL=administration@hands.vn

# Local services stay local until a hosted database is chosen.
DATABASE_URL=postgresql://massage:massage@localhost:5432/massage_vn?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_DB=massage_vn
POSTGRES_USER=massage
POSTGRES_PASSWORD=

# Local JWT secrets for Nest-issued tokens.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Auth migration mode.
# Keep nest until Supabase Phone Auth and auth:supabase-smoke pass.
AUTH_BACKEND=nest

# Supabase project values from Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
# Live Phone Auth smoke number must use Vietnam E.164 format, for example +84900000001.
SUPABASE_PHONE_SMOKE_PHONE=
SUPABASE_PHONE_SMOKE_OTP=
SUPABASE_PHONE_SMOKE_ROLE=CUSTOMER
SUPABASE_PHONE_SMOKE_CREATE_USER=true

# OTP.
SMS_PROVIDER=dev
DEV_OTP=123456
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=HANDS

# Low-cost map and address search.
MAPTILER_API_KEY=
GEOAPIFY_API_KEY=
DISCOVERY_DISTANCE_SORTING_ENABLED=true
MATCHING_MARKETPLACE_ENABLED=true
PARTNER_FILTER_ALERTS_ENABLED=true
LOCATION_FRESH_AFTER_MINUTES=30
LOCATION_WARNING_AFTER_MINUTES=180
PROVIDER_STALE_AFTER_MINUTES=30
PROVIDER_HIDE_AFTER_HOURS=24
ANDROID_CUSTOMER_UPLOAD_KEYSTORE=
ANDROID_PROVIDER_UPLOAD_KEYSTORE=

# Admin-operable matching and operations policy defaults.
# These are seeded into Operational Policy and can be changed from /operations-policy.
MATCHING_TRAVEL_BUFFER_MINUTES=30
MATCHING_PROVIDER_RESPONSE_WINDOW_MINUTES=10
MATCHING_BACKUP_PROVIDER_RADIUS_METERS=10000
MATCHING_BACKUP_PROVIDER_LOCATION_MAX_AGE_MINUTES=30
MATCHING_BACKUP_PROVIDER_INVITATION_LIMIT=50
MATCHING_PREFERRED_ACCEPT_MODE=CUSTOMER_FINAL_CONFIRM_AFTER_ACCEPT
MATCHING_BACKUP_OPEN_MODE=IMMEDIATE_WITHIN_WINDOW
WALLET_NEGATIVE_BALANCE_GATE=BLOCK_MARKETPLACE_PARTICIPATION
CANCELLATION_AFTER_MATCH_POLICY=ADMIN_REVIEW_FOR_MVP
NO_SHOW_PARTNER_REPORT_POLICY=ADMIN_REVIEW_REQUIRED
NOTIFICATION_PARTNER_ALERT_CHANNEL=IN_APP_WITH_PUSH_LATER
PROVIDER_AGREEMENT_VERSION=2026-05

# Storage. Local MinIO works for MVP; replace with Supabase Storage S3, R2, or S3-compatible storage for staging.
STORAGE_PROVIDER=s3-compatible
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=massage-vn
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000/massage-vn
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Vietnam payments.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_IPN_URL=https://api.staging.hands.vn/api/payments/MOMO/callback
MOMO_REDIRECT_URL=
MOMO_HTTP_TIMEOUT_MS=30000
MOMO_GATEWAY_ENABLED=false
VNPAY_GATEWAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=
VNPAY_SERVER_IP=
VNPAY_HTTP_TIMEOUT_MS=30000
ALLOW_UNVERIFIED_PAYMENT_CALLBACKS=false
ALLOW_PLACEHOLDER_PAYMENT_AUTHORIZATIONS=false
CUSTOMER_APP_PAYMENT_REDIRECT_FLOW_ENABLED=false

# Admin web.
ADMIN_API_BASE_URL=http://localhost:3000/api
ADMIN_ACCESS_TOKEN=
ADMIN_REALTIME_TOKEN_SECRET=
ADMIN_WEB_LOGIN_EMAIL=
ADMIN_WEB_LOGIN_PASSWORD_HASH=
ADMIN_WEB_LOGIN_PASSWORD_SALT=
ADMIN_WEB_LOGIN_PASSWORD=
ADMIN_WEB_ALLOW_DEV_LOGIN=false
ADMIN_WEB_SESSION_COOKIE_SECRET=
ADMIN_WEB_SESSION_TTL_SECONDS=28800
ADMIN_WEB_ALLOW_DEV_REALTIME_TOKEN=false
ADMIN_DEMO_PHONE=+84900000099
ADMIN_DEMO_OTP=123456

# FCM is the official Android/iOS OS push provider. Firebase DB/Auth/Firestore are not part of MVP.
PUSH_PROVIDER=in_app_only
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_ADMIN_CREDENTIALS_HOST_PATH=
FIREBASE_ADMIN_CREDENTIALS_CONTAINER_PATH=/run/secrets/firebase-admin.json

# Optional local FCM smoke inputs. Never commit real device tokens.
# FCM_SMOKE_DEVICE_TOKEN must come from the same role, phone, and platform selected below.
# Set FCM_SMOKE_USE_REGISTERED_DEVICE=true only after the same app session registered an enabled device.
FCM_SMOKE_DEVICE_TOKEN=
FCM_SMOKE_USE_REGISTERED_DEVICE=false
FCM_SMOKE_PLATFORM=android
FCM_SMOKE_ROLE=CUSTOMER
FCM_SMOKE_PHONE=
FCM_SMOKE_OTP=
FCM_TOKEN_SMOKE_CUSTOMER_PHONE=
FCM_TOKEN_SMOKE_PROVIDER_PHONE=
FCM_SMOKE_ADMIN_PHONE=
FCM_SMOKE_ADMIN_OTP=
FCM_SMOKE_NOTIFICATION_ID=
FCM_SMOKE_EXPECT_PROVIDER=FCM
FCM_SMOKE_EXPECT_STATUS=ANY
FCM_SMOKE_TIMEOUT_MS=30000
FCM_SMOKE_POLL_INTERVAL_MS=1000
