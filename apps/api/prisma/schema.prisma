generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum BookingStatus {
  CREATED
  OPEN_MATCHING
  MATCHED
  PROVIDER_ON_THE_WAY
  ARRIVED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
  REFUNDED
}

enum BookingMatchSource {
  FIRST_PICK_ACCEPTED_FIRST
  CUSTOMER_SELECTED_PARTNER
}

enum ProviderStatus {
  OFFLINE
  ONLINE_AVAILABLE
  ONLINE_BUSY
  ONLINE_AVAILABLE_SOON
}

enum ProviderLevel {
  LEVEL_1_SIGNUP
  LEVEL_2_ACTIVE
  LEVEL_3_PAYOUT_ENABLED
  LEVEL_4_TRUSTED
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ProviderKycStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum ProviderDocumentType {
  CCCD_FRONT
  CCCD_BACK
  SELFIE
  PROFILE_PHOTO
  WORK_PHOTO
  BANK_QR
}

enum ProviderDocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ProviderBankAccountStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  DISABLED
}

enum ProviderTaxProfileStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TaxPolicyStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TaxRuleScope {
  DEFAULT
  SERVICE_TYPE
  AMOUNT_BAND
}

enum ProviderAgreementType {
  TERMS
  PRIVACY
  LOCATION
  PAYOUT
  TAX
}

enum ParticipantStatus {
  JOINED
  ACCEPTED
  REJECTED
  SELECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  RELEASED
}

enum PaymentMethod {
  MOMO
  VNPAY
  CASH
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum FilePurpose {
  PROVIDER_VERIFICATION
  PROVIDER_GALLERY
  CHAT_ATTACHMENT
  PROFILE_IMAGE
}

enum FileUploadStatus {
  PENDING
  UPLOADED
  FAILED
}

enum FileReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REPORTED
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID
  CANCELLED
}

enum CashFeeSettlementMethod {
  PARTNER_DEPOSIT
  ADMIN_OFFSET
}

enum PayoutBatchStatus {
  DRAFT
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum ProviderWalletLedgerType {
  BOOKING_EARNING
  CASH_FEE_DEBT_SETTLED
  PAYOUT_PAID
  REFUND_REVERSAL
  ADMIN_ADJUSTMENT
}

enum BookingOpsTaskType {
  CUSTOMER_CONTACTED
  PROVIDER_CONTACTED
  LOCATION_CHECKED
  PAYMENT_REVIEWED
}

enum BookingOpsTaskStatus {
  PENDING
  DONE
  BLOCKED
}

enum ProviderReportSource {
  CUSTOMER
  PROVIDER
  ADMIN
  SYSTEM
}

enum ProviderReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProviderReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ProviderSanctionType {
  WARNING
  ACCOUNT_BLOCK
  PAYOUT_HOLD
  TRUST_BADGE_REMOVAL
}

enum ProviderSanctionStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

model User {
  id                       String                     @id @default(cuid())
  supabaseUserId           String?                    @unique
  phone                    String                     @unique
  email                    String?
  fullName                 String?
  roles                    Role[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  customerProfile          CustomerProfile?
  providerProfile          ProviderProfile?
  notifications            Notification[]
  pushDevices              PushDevice[]
  chatMessages             ChatMessage[]
  auditLogs                AdminAuditLog[]            @relation("AdminActor")
  bookingOpsTasks          BookingOpsTask[]           @relation("BookingOpsTaskActor")
  appSessions              AppSession[]
  fileAssets               FileAsset[]                @relation("FileAssetOwner")
  reviewedFileAssets       FileAsset[]                @relation("FileAssetReviewer")
  taxPolicyVersions        TaxPolicyVersion[]         @relation("TaxPolicyAuthor")
  platformFeePolicies      PlatformFeePolicyVersion[] @relation("PlatformFeePolicyAuthor")
  providerVerificationLogs ProviderVerificationLog[]  @relation("ProviderVerificationLogActor")
  providerReportsCreated   ProviderReport[]           @relation("ProviderReportCreator")
  providerReportsAssigned  ProviderReport[]           @relation("ProviderReportAssignee")
  providerSanctionsIssued  ProviderSanction[]         @relation("ProviderSanctionIssuer")
  providerSanctionsLifted  ProviderSanction[]         @relation("ProviderSanctionLifter")
  operationalPolicyUpdates OperationalPolicySetting[]  @relation("OperationalPolicySettingUpdater")
}

model AppSession {
  id         String    @id @default(cuid())
  userId     String
  role       Role
  deviceId   String
  platform   String?
  appVersion String?
  deviceLanguage String?
  lastLoginAddress String?
  ipAddress  String?
  active     Boolean   @default(true)
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id])

  @@unique([userId, role, deviceId])
  @@index([role, active, lastSeenAt])
  @@index([userId, lastSeenAt])
}

model CustomerProfile {
  id                String                     @id @default(cuid())
  userId            String                     @unique
  user              User                       @relation(fields: [userId], references: [id])
  addresses         Json?
  bookings          Booking[]
  bookingSnapshots  BookingAddressSnapshot[]
  reviews           Review[]
  selectedLocations CustomerSelectedLocation[]
}

model ProviderProfile {
  id                       String                      @id @default(cuid())
  userId                   String                      @unique
  user                     User                        @relation(fields: [userId], references: [id])
  displayName              String
  legalName                String?
  dateOfBirth              DateTime?
  gender                   String?
  facebookId               String?
  activityNickname         String?
  bio                      String?
  experienceYears          Int?
  specialties              Json?
  languages                Json?
  serviceStyle             String?
  residentialAddress       String?
  city                     String?
  serviceArea              Json?
  level                    ProviderLevel               @default(LEVEL_1_SIGNUP)
  status                   ProviderStatus              @default(OFFLINE)
  ratingAvg                Decimal                     @default(0) @db.Decimal(3, 2)
  reviewCount              Int                         @default(0)
  currentLat               Decimal?                    @db.Decimal(10, 7)
  currentLng               Decimal?                    @db.Decimal(10, 7)
  currentLocationUpdatedAt DateTime?
  nextAvailableAt          DateTime?
  blockedAt                DateTime?
  blockedReason            String?
  trustedAt                DateTime?
  deletedAt                DateTime?
  updatedAt                DateTime                    @default(now()) @updatedAt
  verification             ProviderVerification?
  kyc                      ProviderKyc?
  documents                ProviderDocument[]
  bankAccounts             ProviderBankAccount[]
  taxProfile               ProviderTaxProfile?
  taxLogs                  ProviderTaxLog[]
  platformFeeLogs          ProviderPlatformFeeLog[]
  agreements               ProviderAgreement[]
  verificationLogs         ProviderVerificationLog[]
  sessions                 ProviderSession[]
  devices                  ProviderDevice[]
  services                 ProviderService[]
  participants             BookingParticipant[]
  preferredBookings        Booking[]                   @relation("PreferredProvider")
  selectedBookings         Booking[]                   @relation("SelectedProvider")
  locationSnapshots        LocationSnapshot[]
  reviews                  Review[]
  earnings                 ProviderEarning[]
  payoutBatches            ProviderPayoutBatch[]
  walletLedgerEntries      ProviderWalletLedgerEntry[]
  reports                  ProviderReport[]
  sanctions                ProviderSanction[]
}

model ProviderKyc {
  id                String            @id @default(cuid())
  providerProfileId String            @unique
  cccdNumberHash    String?
  cccdNumberLast4   String?
  status            ProviderKycStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  rejectionReason   String?
  blockedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  providerProfile   ProviderProfile   @relation(fields: [providerProfileId], references: [id])
}

model ProviderDocument {
  id                String                 @id @default(cuid())
  providerProfileId String
  fileAssetId       String                 @unique
  type              ProviderDocumentType
  status            ProviderDocumentStatus @default(PENDING_REVIEW)
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  providerProfile   ProviderProfile        @relation(fields: [providerProfileId], references: [id])
  fileAsset         FileAsset              @relation(fields: [fileAssetId], references: [id])

  @@index([providerProfileId, type, status])
}

model ProviderBankAccount {
  id                  String                    @id @default(cuid())
  providerProfileId   String
  bankName            String
  accountNumberMasked String?
  accountNumberLast4  String?
  accountHolderName   String
  qrBankingInfo       Json?
  status              ProviderBankAccountStatus @default(PENDING_REVIEW)
  isPrimary           Boolean                   @default(false)
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  deletedAt           DateTime?
  providerProfile     ProviderProfile           @relation(fields: [providerProfileId], references: [id])

  @@index([providerProfileId, status])
}

model ProviderTaxProfile {
  id                String                   @id @default(cuid())
  providerProfileId String                   @unique
  taxCodeHash       String?
  taxCodeLast4      String?
  legalName         String
  registeredAddress String
  status            ProviderTaxProfileStatus @default(PENDING_REVIEW)
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  providerProfile   ProviderProfile          @relation(fields: [providerProfileId], references: [id])
  taxLogs           ProviderTaxLog[]
}

model ProviderAgreement {
  id                String                @id @default(cuid())
  providerProfileId String
  type              ProviderAgreementType
  version           String
  acceptedAt        DateTime              @default(now())
  ipAddress         String?
  deviceId          String?
  createdAt         DateTime              @default(now())
  providerProfile   ProviderProfile       @relation(fields: [providerProfileId], references: [id])

  @@unique([providerProfileId, type, version])
  @@index([providerProfileId, type, acceptedAt])
}

model ProviderVerificationLog {
  id                String          @id @default(cuid())
  providerProfileId String
  actorId           String?
  action            String
  fromStatus        String?
  toStatus          String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  actor             User?           @relation("ProviderVerificationLogActor", fields: [actorId], references: [id])

  @@index([providerProfileId, createdAt])
  @@index([actorId, createdAt])
}

model ProviderReport {
  id                String                 @id @default(cuid())
  providerProfileId String
  bookingId         String?
  source            ProviderReportSource   @default(ADMIN)
  severity          ProviderReportSeverity @default(MEDIUM)
  status            ProviderReportStatus   @default(OPEN)
  category          String
  summary           String
  details           String?
  reporterUserId    String?
  assignedAdminId   String?
  resolvedAt        DateTime?
  resolutionNote    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  providerProfile   ProviderProfile        @relation(fields: [providerProfileId], references: [id])
  booking           Booking?               @relation(fields: [bookingId], references: [id])
  reporterUser      User?                  @relation("ProviderReportCreator", fields: [reporterUserId], references: [id])
  assignedAdmin     User?                  @relation("ProviderReportAssignee", fields: [assignedAdminId], references: [id])
  sanctions         ProviderSanction[]

  @@index([providerProfileId, status, severity])
  @@index([bookingId])
  @@index([status, severity, createdAt])
  @@index([assignedAdminId, status])
}

model ProviderSanction {
  id                String                 @id @default(cuid())
  providerProfileId String
  reportId          String?
  type              ProviderSanctionType
  status            ProviderSanctionStatus @default(ACTIVE)
  reason            String
  startsAt          DateTime               @default(now())
  expiresAt         DateTime?
  liftedAt          DateTime?
  issuedById        String?
  liftedById        String?
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  providerProfile   ProviderProfile        @relation(fields: [providerProfileId], references: [id])
  report            ProviderReport?        @relation(fields: [reportId], references: [id])
  issuedBy          User?                  @relation("ProviderSanctionIssuer", fields: [issuedById], references: [id])
  liftedBy          User?                  @relation("ProviderSanctionLifter", fields: [liftedById], references: [id])

  @@index([providerProfileId, status, type])
  @@index([reportId])
  @@index([status, startsAt])
}

model ProviderSession {
  id                String          @id @default(cuid())
  providerProfileId String
  deviceId          String?
  ipAddress         String?
  appVersion        String?
  loggedInAt        DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  suspicious        Boolean         @default(false)
  suspiciousReason  String?
  createdAt         DateTime        @default(now())
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])

  @@index([providerProfileId, lastSeenAt])
  @@index([deviceId])
}

model ProviderDevice {
  id                String          @id @default(cuid())
  providerProfileId String
  deviceId          String
  platform          String?
  appVersion        String?
  enabled           Boolean         @default(true)
  lastSeenAt        DateTime?
  blockedAt         DateTime?
  blockReason       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])

  @@unique([providerProfileId, deviceId])
  @@index([providerProfileId, enabled])
}

model CustomerSelectedLocation {
  id                String          @id @default(cuid())
  customerProfileId String
  latitude          Decimal         @db.Decimal(10, 7)
  longitude         Decimal         @db.Decimal(10, 7)
  addressText       String
  createdAt         DateTime        @default(now())
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  bookingSnapshots  BookingAddressSnapshot[]

  @@index([customerProfileId, createdAt])
}

model ProviderVerification {
  id                String             @id @default(cuid())
  providerProfileId String             @unique
  providerProfile   ProviderProfile    @relation(fields: [providerProfileId], references: [id])
  status            VerificationStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  rejectionReason   String?
  files             FileAsset[]
}

model MassageService {
  id              String              @id @default(cuid())
  serviceGroupKey String?
  name            String
  description     String?
  durationMin     Int
  basePrice       Int
  priceStep       Int                 @default(100000)
  displayOrder    Int                 @default(0)
  active          Boolean             @default(true)
  providers       ProviderService[]
  bookings        BookingService[]
  payoutRules     ServicePayoutRule[]

  @@index([serviceGroupKey, durationMin])
  @@index([active, displayOrder])
}

model ProviderService {
  id                String          @id @default(cuid())
  providerProfileId String
  serviceId         String
  price             Int
  active            Boolean         @default(true)
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  service           MassageService  @relation(fields: [serviceId], references: [id])

  @@unique([providerProfileId, serviceId])
}

model ServicePayoutRule {
  id                   String         @id @default(cuid())
  serviceId            String
  customerPrice        Int
  providerPayoutAmount Int
  vatBps               Int            @default(0)
  otherCostAmount      Int            @default(0)
  currency             String         @default("VND")
  active               Boolean        @default(true)
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  service              MassageService @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, customerPrice])
  @@index([serviceId, active])
}

model Booking {
  id                  String                      @id @default(cuid())
  customerProfileId   String
  preferredProviderId String?
  selectedProviderId  String?
  status              BookingStatus               @default(CREATED)
  scheduledStartAt    DateTime
  scheduledEndAt      DateTime
  address             Json
  lat                 Decimal                     @db.Decimal(10, 7)
  lng                 Decimal                     @db.Decimal(10, 7)
  notes               String?
  metadata            Json?
  travelBufferMin     Int                         @default(30)
  earlyAcceptMin      Int                         @default(20)
  openedAt            DateTime?
  expiresAt           DateTime?
  matchedAt           DateTime?
  matchSource         BookingMatchSource?
  closedAt            DateTime?
  closedByRole        Role?
  closedReason        String?
  closedNote          String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  customerProfile     CustomerProfile             @relation(fields: [customerProfileId], references: [id])
  preferredProvider   ProviderProfile?            @relation("PreferredProvider", fields: [preferredProviderId], references: [id])
  selectedProvider    ProviderProfile?            @relation("SelectedProvider", fields: [selectedProviderId], references: [id])
  services            BookingService[]
  participants        BookingParticipant[]
  chatRoom            ChatRoom?
  payment             Payment?
  review              Review?
  refunds             Refund[]
  snapshots           LocationSnapshot[]
  earning             ProviderEarning?
  platformFeeLogs     ProviderPlatformFeeLog[]
  taxLogs             ProviderTaxLog[]
  opsTasks            BookingOpsTask[]
  providerReports     ProviderReport[]
  walletLedgerEntries ProviderWalletLedgerEntry[]
  addressSnapshot     BookingAddressSnapshot?

  @@index([status, closedAt])
  @@index([closedByRole, closedAt])
}

model BookingAddressSnapshot {
  id                 String                    @id @default(cuid())
  bookingId          String                    @unique
  customerProfileId  String
  selectedLocationId String?
  address            Json
  addressText        String?
  latitude           Decimal                   @db.Decimal(10, 7)
  longitude          Decimal                   @db.Decimal(10, 7)
  source             String                    @default("booking_confirmation")
  createdAt          DateTime                  @default(now())
  booking            Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerProfile    CustomerProfile           @relation(fields: [customerProfileId], references: [id])
  selectedLocation   CustomerSelectedLocation? @relation(fields: [selectedLocationId], references: [id], onDelete: SetNull)

  @@index([customerProfileId, createdAt])
  @@index([selectedLocationId])
}

model BookingOpsTask {
  id        String               @id @default(cuid())
  bookingId String
  type      BookingOpsTaskType
  status    BookingOpsTaskStatus @default(PENDING)
  note      String?
  actorId   String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  booking   Booking              @relation(fields: [bookingId], references: [id])
  actor     User                 @relation("BookingOpsTaskActor", fields: [actorId], references: [id])

  @@unique([bookingId, type])
  @@index([bookingId, status])
  @@index([actorId, updatedAt])
}

model BookingService {
  id        String         @id @default(cuid())
  bookingId String
  serviceId String
  quantity  Int            @default(1)
  price     Int
  booking   Booking        @relation(fields: [bookingId], references: [id])
  service   MassageService @relation(fields: [serviceId], references: [id])
}

model BookingParticipant {
  id                   String            @id @default(cuid())
  bookingId            String
  providerProfileId    String
  status               ParticipantStatus @default(JOINED)
  distanceMeters       Int?
  providerStatusAtJoin ProviderStatus?
  joinedAt             DateTime          @default(now())
  respondedAt          DateTime?
  booking              Booking           @relation(fields: [bookingId], references: [id])
  providerProfile      ProviderProfile   @relation(fields: [providerProfileId], references: [id])

  @@unique([bookingId, providerProfileId])
}

model ChatRoom {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id          String   @id @default(cuid())
  chatRoomId  String
  senderId    String
  body        String
  attachments Json?
  createdAt   DateTime @default(now())
  chatRoom    ChatRoom @relation(fields: [chatRoomId], references: [id])
  sender      User     @relation(fields: [senderId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Int
  currency    String        @default("VND")
  providerRef String?       @unique
  rawMeta     Json?
  booking     Booking       @relation(fields: [bookingId], references: [id])
  refunds     Refund[]
  callbackAttempts PaymentCallbackAttempt[]
}

model PaymentCallbackAttempt {
  id                   String         @id @default(cuid())
  paymentId            String?
  method               PaymentMethod
  providerRef          String?
  outcome              String
  signatureVerified    Boolean?
  verificationMode     String?
  providerStatus       String?
  gatewayTransactionId String?
  callbackAmount       Int?
  errorCode            String?
  errorMessage         String?
  rawPayload           Json?
  createdAt            DateTime       @default(now())
  payment              Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([method, outcome, createdAt])
  @@index([providerRef, createdAt])
  @@index([createdAt])
}

model Review {
  id                String          @id @default(cuid())
  bookingId         String          @unique
  customerProfileId String
  providerProfileId String
  rating            Int
  comment           String?
  status            ReviewStatus    @default(PUBLISHED)
  reportReason      String?
  moderatedAt       DateTime?
  createdAt         DateTime        @default(now())
  booking           Booking         @relation(fields: [bookingId], references: [id])
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
}

model ProviderEarning {
  id                  String                      @id @default(cuid())
  providerProfileId   String
  bookingId           String                      @unique
  grossAmount         Int
  platformFee         Int
  withholdingAmount   Int                         @default(0)
  netAmount           Int
  currency            String                      @default("VND")
  status              EarningStatus               @default(PENDING)
  availableAt         DateTime?
  paidAt              DateTime?
  payoutBatchId       String?
  settlementRef       String?
  settlementNotes     String?
  settlementMethod    CashFeeSettlementMethod?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  providerProfile     ProviderProfile             @relation(fields: [providerProfileId], references: [id])
  booking             Booking                     @relation(fields: [bookingId], references: [id])
  payoutBatch         ProviderPayoutBatch?        @relation(fields: [payoutBatchId], references: [id])
  platformFeeLogs     ProviderPlatformFeeLog[]
  taxLogs             ProviderTaxLog[]
  walletLedgerEntries ProviderWalletLedgerEntry[]

  @@index([settlementMethod, paidAt])
}

model ProviderPayoutBatch {
  id                  String                      @id @default(cuid())
  providerProfileId   String
  totalNetAmount      Int
  currency            String                      @default("VND")
  status              PayoutBatchStatus           @default(DRAFT)
  transferRef         String?
  notes               String?
  createdAt           DateTime                    @default(now())
  paidAt              DateTime?
  providerProfile     ProviderProfile             @relation(fields: [providerProfileId], references: [id])
  earnings            ProviderEarning[]
  withholdingLogs     WithholdingLog[]
  walletLedgerEntries ProviderWalletLedgerEntry[]
}

model ProviderWalletLedgerEntry {
  id                String                   @id @default(cuid())
  providerProfileId String
  bookingId         String?
  earningId         String?
  payoutBatchId     String?
  type              ProviderWalletLedgerType
  sourceKey         String                   @unique
  amount            Int
  currency          String                   @default("VND")
  reference         String?
  notes             String?
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  providerProfile   ProviderProfile          @relation(fields: [providerProfileId], references: [id])
  booking           Booking?                 @relation(fields: [bookingId], references: [id])
  earning           ProviderEarning?         @relation(fields: [earningId], references: [id])
  payoutBatch       ProviderPayoutBatch?     @relation(fields: [payoutBatchId], references: [id])

  @@index([providerProfileId, createdAt])
  @@index([bookingId])
  @@index([earningId])
  @@index([payoutBatchId])
  @@index([type, createdAt])
}

model TaxPolicyVersion {
  id            String           @id @default(cuid())
  name          String
  status        TaxPolicyStatus  @default(DRAFT)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     User?            @relation("TaxPolicyAuthor", fields: [createdById], references: [id])
  rules         TaxRule[]
  taxLogs       ProviderTaxLog[]

  @@index([status, effectiveFrom])
}

model TaxRule {
  id              String           @id @default(cuid())
  policyVersionId String
  scope           TaxRuleScope     @default(DEFAULT)
  serviceType     String?
  minGrossAmount  Int?
  maxGrossAmount  Int?
  rateBps         Int              @default(0)
  fixedAmount     Int              @default(0)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  policyVersion   TaxPolicyVersion @relation(fields: [policyVersionId], references: [id])

  @@index([policyVersionId, scope, active])
}

model PlatformFeePolicyVersion {
  id            String                   @id @default(cuid())
  name          String
  status        TaxPolicyStatus          @default(DRAFT)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?
  createdById   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  createdBy     User?                    @relation("PlatformFeePolicyAuthor", fields: [createdById], references: [id])
  rules         PlatformFeeRule[]
  feeLogs       ProviderPlatformFeeLog[]

  @@index([status, effectiveFrom])
}

model PlatformFeeRule {
  id              String                   @id @default(cuid())
  policyVersionId String
  scope           TaxRuleScope             @default(DEFAULT)
  serviceType     String?
  minGrossAmount  Int?
  maxGrossAmount  Int?
  rateBps         Int                      @default(0)
  fixedAmount     Int                      @default(0)
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  policyVersion   PlatformFeePolicyVersion @relation(fields: [policyVersionId], references: [id])

  @@index([policyVersionId, scope, active])
}

model ProviderPlatformFeeLog {
  id                String                    @id @default(cuid())
  providerProfileId String
  bookingId         String?
  earningId         String?
  policyVersionId   String?
  grossAmount       Int
  platformFeeAmount Int
  currency          String                    @default("VND")
  ruleSnapshot      Json?
  createdAt         DateTime                  @default(now())
  providerProfile   ProviderProfile           @relation(fields: [providerProfileId], references: [id])
  booking           Booking?                  @relation(fields: [bookingId], references: [id])
  earning           ProviderEarning?          @relation(fields: [earningId], references: [id])
  policyVersion     PlatformFeePolicyVersion? @relation(fields: [policyVersionId], references: [id])

  @@index([providerProfileId, createdAt])
  @@index([bookingId])
  @@index([earningId])
}

model ProviderTaxLog {
  id                String              @id @default(cuid())
  providerProfileId String
  bookingId         String?
  earningId         String?
  taxProfileId      String?
  policyVersionId   String?
  grossAmount       Int
  taxableAmount     Int
  withholdingAmount Int
  currency          String              @default("VND")
  ruleSnapshot      Json?
  createdAt         DateTime            @default(now())
  providerProfile   ProviderProfile     @relation(fields: [providerProfileId], references: [id])
  booking           Booking?            @relation(fields: [bookingId], references: [id])
  earning           ProviderEarning?    @relation(fields: [earningId], references: [id])
  taxProfile        ProviderTaxProfile? @relation(fields: [taxProfileId], references: [id])
  policyVersion     TaxPolicyVersion?   @relation(fields: [policyVersionId], references: [id])
  withholdingLogs   WithholdingLog[]

  @@index([providerProfileId, createdAt])
  @@index([bookingId])
  @@index([earningId])
}

model WithholdingLog {
  id               String               @id @default(cuid())
  providerTaxLogId String
  payoutBatchId    String?
  amount           Int
  status           String               @default("PENDING")
  metadata         Json?
  createdAt        DateTime             @default(now())
  providerTaxLog   ProviderTaxLog       @relation(fields: [providerTaxLogId], references: [id])
  payoutBatch      ProviderPayoutBatch? @relation(fields: [payoutBatchId], references: [id])

  @@index([payoutBatchId, status])
}

model Notification {
  id         String                 @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String
  data       Json?
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]
}

model PushDevice {
  id         String                 @id @default(cuid())
  userId     String
  role       Role                   @default(CUSTOMER)
  token      String                 @unique
  platform   String
  enabled    Boolean                @default(true)
  lastSeenAt DateTime               @default(now())
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId, role, enabled])
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  pushDeviceId   String
  provider       String
  status         String
  response       Json?
  attemptedAt    DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id])
  pushDevice     PushDevice   @relation(fields: [pushDeviceId], references: [id])
}

model FileAsset {
  id                     String                @id @default(cuid())
  key                    String                @unique
  url                    String?
  contentType            String
  purpose                FilePurpose           @default(PROVIDER_VERIFICATION)
  visibility             FileVisibility
  uploadStatus           FileUploadStatus      @default(PENDING)
  reviewStatus           FileReviewStatus      @default(PENDING_REVIEW)
  reviewedAt             DateTime?
  reviewReason           String?
  reviewedById           String?
  reviewedBy             User?                 @relation("FileAssetReviewer", fields: [reviewedById], references: [id])
  uploadedAt             DateTime?
  sizeBytes              Int?
  ownerUserId            String?
  owner                  User?                 @relation("FileAssetOwner", fields: [ownerUserId], references: [id])
  providerVerificationId String?
  providerVerification   ProviderVerification? @relation(fields: [providerVerificationId], references: [id])
  providerDocument       ProviderDocument?
  createdAt              DateTime              @default(now())

  @@index([ownerUserId, purpose, createdAt])
  @@index([visibility, purpose, createdAt])
  @@index([reviewStatus, purpose, createdAt])
}

model LocationSnapshot {
  id                String          @id @default(cuid())
  bookingId         String?
  providerProfileId String
  addressText       String?
  lat               Decimal         @db.Decimal(10, 7)
  lng               Decimal         @db.Decimal(10, 7)
  recordedAt        DateTime        @default(now())
  booking           Booking?        @relation(fields: [bookingId], references: [id])
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  discount    Json
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
}

model Refund {
  id        String   @id @default(cuid())
  bookingId String
  paymentId String
  amount    Int
  reason    String?
  status    String   @default("REQUESTED")
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  payment   Payment  @relation(fields: [paymentId], references: [id])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation("AdminActor", fields: [actorId], references: [id])
}

model OperationalPolicySetting {
  key              String   @id
  category         String
  label            String
  description      String?
  value            Json
  recommendedValue Json?
  options          Json?
  requiresRestart  Boolean  @default(false)
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedBy        User?    @relation("OperationalPolicySettingUpdater", fields: [updatedById], references: [id])

  @@index([category])
  @@index([updatedAt])
}
