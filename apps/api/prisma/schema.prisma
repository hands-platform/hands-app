model User {
  id                               String                         @id @default(cuid())
  supabaseUserId                   String?                        @unique
  phone                            String                         @unique
  email                            String?
  fullName                         String?
  roles                            Role[]
  createdAt                        DateTime                       @default(now())
  updatedAt                        DateTime                       @updatedAt
  adminUserProvenance              AdminUserProvenance?
  fixtureKind                      String?
  fixtureRunId                     String?
  fixtureExpiresAt                 DateTime?
  customerProfile                  CustomerProfile?
  providerProfile                  ProviderProfile?
  notifications                    Notification[]
  notificationDeliveryIncidentsOwned NotificationDeliveryIncident[] @relation("NotificationDeliveryIncidentOwner")
  notificationDeliveryIncidentsResolved NotificationDeliveryIncident[] @relation("NotificationDeliveryIncidentResolver")
  pushDevices                      PushDevice[]
  chatMessages                     ChatMessage[]
  auditLogs                        AdminAuditLog[]                @relation("AdminActor")
  bookingOpsTasks                  BookingOpsTask[]               @relation("BookingOpsTaskActor")
  appSessions                      AppSession[]
  appUsageEvents                   AppUsageEvent[]
  appUsageDailyAggregates          AppUsageDailyAggregate[]
  fileAssets                       FileAsset[]                    @relation("FileAssetOwner")
  reviewedFileAssets               FileAsset[]                    @relation("FileAssetReviewer")
  taxPolicyVersions                TaxPolicyVersion[]             @relation("TaxPolicyAuthor")
  platformFeePolicies              PlatformFeePolicyVersion[]     @relation("PlatformFeePolicyAuthor")
  paymentFeePolicies               PaymentFeePolicyVersion[]      @relation("PaymentFeePolicyAuthor")
  providerVerificationLogs         ProviderVerificationLog[]      @relation("ProviderVerificationLogActor")
  providerReportsCreated           ProviderReport[]               @relation("ProviderReportCreator")
  providerReportsAssigned          ProviderReport[]               @relation("ProviderReportAssignee")
  providerSanctionsIssued          ProviderSanction[]             @relation("ProviderSanctionIssuer")
  providerSanctionsLifted          ProviderSanction[]             @relation("ProviderSanctionLifter")
  operationalPolicyUpdates         OperationalPolicySetting[]     @relation("OperationalPolicySettingUpdater")
  accountingJournalBatches         AccountingJournalBatch[]       @relation("AccountingJournalBatchCreator")
  bankReconciliationMatches        BankReconciliationMatch[]      @relation("BankReconciliationMatcher")
  adminOperatorPermission          AdminOperatorPermission?
  adminOperatorCredential          AdminOperatorCredential?
  adminOperatorInvitationsTargeted AdminOperatorInvitation[]      @relation("AdminOperatorInvitationTarget")
  adminOperatorInvitationsCreated  AdminOperatorInvitation[]      @relation("AdminOperatorInvitationCreator")
  adminWebSessions                 AdminWebSession[]              @relation("AdminWebSessionUser")
  adminWebSessionsRevoked          AdminWebSession[]              @relation("AdminWebSessionRevoker")
  financeApproverRequestsTargeted  FinanceApproverAccessRequest[] @relation("FinanceApproverRequestTarget")
  financeApproverRequestsCreated   FinanceApproverAccessRequest[] @relation("FinanceApproverRequestMaker")
  financeApproverRequestsDecided   FinanceApproverAccessRequest[] @relation("FinanceApproverRequestChecker")
  taxPolicyApprovalRequestsCreated TaxPolicyApprovalRequest[]     @relation("TaxPolicyApprovalRequestMaker")
  taxPolicyApprovalRequestsDecided TaxPolicyApprovalRequest[]     @relation("TaxPolicyApprovalRequestChecker")
  taxPoliciesApproved              TaxPolicyVersion[]             @relation("TaxPolicyApprover")
  companyBankAccountEvidenceSubmitted CompanyBankAccountEvidence[] @relation("CompanyBankAccountEvidenceSubmitter")
  companyBankAccountEvidenceReviewed CompanyBankAccountEvidence[] @relation("CompanyBankAccountEvidenceReviewer")
  companyBankAccountEvidenceRevoked CompanyBankAccountEvidence[] @relation("CompanyBankAccountEvidenceRevoker")
}

model FinanceApproverAccessRequest {
  id                      String                             @id @default(cuid())
  targetUserId            String
  requestedEnabled        Boolean
  previousEnabled         Boolean
  previousRoles           Role[]
  requestedByAdminId      String
  operatorReason          String
  requestedAt             DateTime                           @default(now())
  expectedTargetUpdatedAt DateTime
  expectedPermissionVersion Int?
  status                  FinanceApproverAccessRequestStatus @default(PENDING)
  decidedByAdminId        String?
  decisionReason          String?
  decidedAt               DateTime?
  executedAt              DateTime?
  idempotencyKey          String                             @unique
  pendingKey              String?                            @unique
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt
  targetUser              User                               @relation("FinanceApproverRequestTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  requestedByAdmin        User                               @relation("FinanceApproverRequestMaker", fields: [requestedByAdminId], references: [id], onDelete: Restrict)
  decidedByAdmin          User?                              @relation("FinanceApproverRequestChecker", fields: [decidedByAdminId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([targetUserId, requestedAt])
  @@index([requestedByAdminId, requestedAt])
  @@index([decidedByAdminId, decidedAt])
}

model AdminOperatorPermission {
  id         String                            @id @default(cuid())
  userId     String                            @unique
  categories AdminOperatorPermissionCategory[]
  version    Int                               @default(1)
  createdAt  DateTime                          @default(now())
  updatedAt  DateTime                          @updatedAt
  user       User                              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model AdminOperatorCredential {
  id                    String    @id @default(cuid())
  userId                String    @unique
  email                 String    @unique
  passwordHash          String
  passwordSalt          String
  passwordUpdatedAt     DateTime  @default(now())
  setupCompletedAt      DateTime?
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastFailedLoginAt     DateTime?
  disabledAt            DateTime?
  disabledReason        String?
  mfaState              String    @default("NOT_CONFIGURED")
  mfaSecretEncrypted    String?
  mfaRecoveryCodeHashes String[]  @default([])
  mfaEnrolledAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@index([disabledAt])
  @@index([lockedUntil])
}

model AdminOperatorInvitation {
  id                   String                            @id @default(cuid())
  normalizedEmail      String
  pendingKey           String?                           @unique
  fullName             String?
  targetUserId         String?
  permissionCategories AdminOperatorPermissionCategory[]
  masterAdminEnabled   Boolean                           @default(false)
  tokenHash            String                            @unique
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  invitedByAdminId     String
  reason               String
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  targetUser           User?                             @relation("AdminOperatorInvitationTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  invitedByAdmin       User                              @relation("AdminOperatorInvitationCreator", fields: [invitedByAdminId], references: [id], onDelete: Restrict)

  @@index([normalizedEmail, createdAt])
  @@index([expiresAt])
  @@index([targetUserId, createdAt])
}

model AdminWebSession {
  id                String    @id
  userId            String
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  revokedByAdminId  String?
  revocationReason  String?
  platformSummary   String?
  reauthenticatedAt DateTime?
  mfaVerifiedAt     DateTime?
  user              User      @relation("AdminWebSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  revokedByAdmin    User?     @relation("AdminWebSessionRevoker", fields: [revokedByAdminId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([revokedAt, expiresAt])
}

model AppSession {
  id               String    @id @default(cuid())
  userId           String
  role             Role
  deviceId         String
  platform         String?
  appVersion       String?
  deviceLanguage   String?
  lastLoginAddress String?
  ipAddress        String?
  active           Boolean   @default(true)
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])

  @@unique([userId, role, deviceId])
  @@index([role, active, lastSeenAt])
  @@index([userId, lastSeenAt])
}

model AppUsageEvent {
  id            String            @id @default(cuid())
  clientEventId String?           @unique
  userId        String
  role          Role
  eventType     AppUsageEventType
  origin        AppUsageOrigin    @default(UNKNOWN)
  deviceId      String?
  subjectType   String?
  subjectId     String?
  occurredAt    DateTime          @default(now())
  metadata      Json?
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventType, occurredAt])
  @@index([userId, eventType, occurredAt])
  @@index([role, eventType, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
}

model AppUsageDailyAggregate {
  id                       String         @id @default(cuid())
  userId                   String
  role                     Role
  origin                   AppUsageOrigin @default(UNKNOWN)
  day                      DateTime       @db.Date
  totalEventCount          Int            @default(0)
  appOpenCount             Int            @default(0)
  sessionStartCount        Int            @default(0)
  providerProfileViewCount Int            @default(0)
  firstOccurredAt          DateTime
  lastOccurredAt           DateTime
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, day, origin])
  @@index([role, origin, day])
  @@index([day, lastOccurredAt])
}

model AppVersionPolicy {
  id                      String   @id @default(cuid())
  appType                 String
  platform                String
  minimumSupportedVersion String?
  latestVersion           String?
  forceUpdate             Boolean  @default(false)
  updateUrl               String?
  releaseNotes            String?
  isActive                Boolean  @default(true)
  metadata                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([appType, platform])
  @@index([appType, platform, isActive])
}

model CustomerProfile {
  id                       String                        @id @default(cuid())
  userId                   String                        @unique
  user                     User                          @relation(fields: [userId], references: [id])
  gender                   String?
  nationality              String?
  addresses                Json?
  bookings                 Booking[]
  bookingSnapshots         BookingAddressSnapshot[]
  settlementSnapshots      BookingSettlementSnapshot[]
  favoriteProviders        CustomerFavoriteProvider[]
  viewedProviders          CustomerProviderProfileView[]
  reviews                  Review[]
  providerReviews          ProviderCustomerReview[]
  selectedLocations        CustomerSelectedLocation[]
  referralCodes            ReferralCode[]                @relation("CustomerReferralCodeOwner")
  referralsMade            ReferralAttribution[]         @relation("CustomerReferralReferrer")
  referralsReceived        ReferralAttribution[]         @relation("CustomerReferralReferred")
  referralRewards          ReferralReward[]              @relation("CustomerReferralWalletOwner")
  walletLedgerEntries      CustomerWalletLedgerEntry[]
  accountingJournalBatches AccountingJournalBatch[]
  couponRedemptions        CouponRedemption[]
}

model CustomerFavoriteProvider {
  id                String          @id @default(cuid())
  customerProfileId String
  providerProfileId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, providerProfileId])
  @@index([customerProfileId, createdAt])
  @@index([providerProfileId, createdAt])
}

model CustomerProviderProfileView {
  id                String          @id @default(cuid())
  customerProfileId String
  providerProfileId String
